# Configuracao nao secreta do Docker Compose.
# Copie para .env. Valores secretos ficam nos arquivos de .secrets/ abaixo.

COMPOSE_PROJECT_NAME=scan-github

# Imagens e rede local
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8.2-alpine
API_BIND_IP=127.0.0.1
API_PORT=8000

# PostgreSQL
POSTGRES_DB=secret_hunter
POSTGRES_USER=secret_hunter
DB_POOL_MIN=1
DB_POOL_MAX=12

# Workers, leases e polling
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=180
WORKER_POLL_SECONDS=2

# Busca GitHub: mantenha um escopo repo:, org: ou user:.
SEARCH_SCOPE=repo:owner/repo
ALLOW_GLOBAL_SEARCH=false
SEARCH_REQUESTS_PER_MINUTE=8
SEARCH_WINDOW_HOURS=1
SEARCH_TYPES=deepseek_api_key_context,mistral_api_key_context,cohere_api_key_context,together_api_key_context,cerebras_api_key_context,azure_openai_api_key_context,ai21_api_key_context,voyage_api_key_context,stability_api_key_context,elevenlabs_api_key_context,assemblyai_api_key_context,pinecone_api_key_context,openai_proj,openai_service,openai_legacy,anthropic_api_key,google_api_key,openrouter_api_key,groq_api_key,huggingface,replicate_api_token,perplexity_api_key,xai_api_key,fireworks_api_key,nvidia_api_key,tavily_api_key,langsmith_api_key
SEARCH_PER_PAGE=30
SEARCH_MAX_PAGES=1
REQUEST_TIMEOUT_SECONDS=10
MAX_FILE_BYTES=1000000

# Drop-zone read-only para conectores futuros (nao faz descoberta/download).
INGEST_HOST_PATH=./ingest
INGEST_ADAPTER=tree
INGEST_SOURCE=
INGEST_POLL_SECONDS=60
INGEST_MAX_FILE_BYTES=1000000

# Descoberta global cripto; todo candidato elegivel segue automaticamente.
DISCOVERY_POLL_SECONDS=15
DISCOVERY_LEASE_SECONDS=180
DISCOVERY_MAX_PAGES=10
DISCOVERY_WINDOW_SECONDS=60
DISCOVERY_HEAD_DELAY_SECONDS=120
DISCOVERY_RECONCILE_SECONDS=900
DISCOVERY_WINDOWS_PER_POLL=4
DISCOVERY_SEARCH_REQUESTS_PER_MINUTE=24
DISCOVERY_METADATA_REQUESTS_PER_HOUR=3000
DISCOVERY_REPOSITORIES_PER_POLL=1000
DISCOVERY_AUTO_QUEUE_SCANS=true
DISCOVERY_INCLUDE_FORKS=false
DISCOVERY_LANGUAGES=
DISCOVERY_MIN_SIZE_KB=1
DISCOVERY_MAX_SIZE_KB=50000
DISCOVERY_HEAD_SCAN_MAX_FILES=2000
DISCOVERY_HEAD_SCAN_MAX_TOTAL_BYTES=20000000
DISCOVERY_HEAD_SCAN_TIMEOUT_SECONDS=120
DISCOVERY_HEAD_SCAN_SAMPLE_PERCENT=100
DISCOVERY_LIVE_MAX_AGE_MINUTES=20
DISCOVERY_MAX_EVENT_AGE_HOURS=4
DISCOVERY_RETENTION_DAYS=30

# Redis Streams: jobs independentes, eventos sanitizados e evidência REST bruta.
EVENT_BUS_ENABLED=true
EVENT_BUS_PREFIX=secret-hunter
EVENT_BUS_BLOCK_MS=5000
EVENT_BUS_CLAIM_IDLE_MS=180000
EVENT_BUS_DISPATCH_BATCH=500
EVENT_BUS_DISPATCH_INTERVAL_MS=250
RAW_EVIDENCE_ENABLED=true
RAW_EVIDENCE_STREAM_KEY=secret-hunter:raw-evidence

# Deteccao e validacao defensiva
AI_DETECTION_ENABLED=true
PRIVATE_KEY_DETECTION_ENABLED=""
SCAN_HISTORY=false
ENTROPY_MIN=3.5
VALIDATE_SECRETS=""
VALIDATE_CRYPTO=false
AUTHORIZED_VALIDATION_REPOS=

# Nunca habilite sem revisao legal e operacional. O default usa canal privado.
ALLOW_PUBLIC_CONTACT_ISSUE=false

# Caminhos no host. Os valores NAO devem ser escritos neste .env.
POSTGRES_PASSWORD_FILE=""
FINGERPRINT_KEY_FILE=./.secrets/fingerprint_key.txt
ADMIN_API_TOKEN_FILE=./.secrets/admin_api_token.txt
REDIS_EVIDENCE_PASSWORD_FILE=""
GITHUB_SEARCH_TOKEN_FILE=./.secrets/github_search_token.txt
GITHUB_NOTIFY_TOKEN_FILE=./.secrets/github_notify_token.txt
