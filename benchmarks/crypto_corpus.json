    {"id": "negative_natural_phrase", "path": "README.md", "template": "{NATURAL_PHRASE}", "expected": []},
    {"id": "negative_placeholder", "path": ".env.example", "template": "PRIVATE_KEY=your_private_key_here", "expected": []}
  ]
}
